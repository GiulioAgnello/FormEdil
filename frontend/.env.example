# Base URL delle REST API del backend WordPress.
# Copia questo file in .env e adatta il valore all'ambiente.
# Produzione (WordPress è installato in /cms, la SPA sta nella radice del dominio):
VITE_API_BASE=https://gestionale.formedillecce.it/cms/wp-json/formedil/v1
# Sviluppo locale (esempio con Local):
# VITE_API_BASE=http://formedillocal.local/wp-json/formedil/v1
